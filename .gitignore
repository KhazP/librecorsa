/scripts/ffb-bridge/bin/

# Offline launcher builds (npm run launcher:build)
/launcher/dist/

# Local notes & scratch dumps
HANDOFF.md
HANDOFF-*.md
acevo_physics_strings.txt

# Wrangler local state and local-only settings (DEV_ORIGINS, a TURN key for testing)
.wrangler/
.dev.vars

