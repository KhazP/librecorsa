AUDIT-*.md
AUDIT-*.jpg
DEVTO-*.md
PORT-ASSESSMENT-*.md
UI-RESEARCH-*.md
/docs/ai/
/scripts/__*

# Hosted-only cars and circuits: served on librecorsa.org from the librecorsa-assets R2 bucket
# (npm run upload-hosted), never committed. The repository carries RISE Motordrome and the 2026 prototype car
# (src/lib/hosted-content.ts)
/public/tracks/*
!/public/tracks/rwanda_official/
!/public/tracks/rwanda_official_short/
!/public/tracks/index.json
# RISE's KTX2 model for phones (src/lib/ktx2-models.ts) is hosted like the other circuits
/public/tracks/rwanda_official/*.ktx2.*.glb
/public/cars/*
!/public/cars/f12026/
/public/gt3/
# The soundtrack (src/lib/audio/music-catalog.ts): hosted like the circuits, never committed
/public/music/
# Mod packages a developer tries in a clone (docs/modding.md, npm run mod -- index)
/public/mods/

# F1 2026 local reference datasets & headless Blender audit outputs
/reference_data/
/artifacts/
*.blend1
