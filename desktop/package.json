{
  "name": "librecorsa-desktop",
  "version": "0.2.0",
  "description": "LibreCorsa desktop wrapper",
  "main": "src/main.js",
  "author": "LibreCorsa",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/hid-policy.js && node --check src/nav-policy.js && npm test",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  },
  "build": {
    "appId": "org.librecorsa.desktop",
    "productName": "LibreCorsa",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "KhazP",
        "repo": "librecorsa",
        "releaseType": "release"
      }
    ],
    "mac": {
      "category": "public.app-category.racing-games",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-${version}-${os}-${arch}-Setup.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    }
  }
}
