{
  "name": "librecorsa",
  "version": "0.2.0",
  "description": "Open-source, browser-based motorsport simulator with 500 Hz vehicle dynamics.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/run-verify.mjs",
    "verify:laps": "node scripts/run-verify.mjs driver-laps",
    "race:headless": "node --disable-warning=THREE_CJS_DEPRECATED --import tsx scripts/race-headless.ts",
    "ffb": "tsx scripts/ffb-bridge.ts",
    "compress-tracks": "node scripts/compress-track-glb.mjs --all"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^16.4.1",
    "postprocessing": "^6.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@tailwindcss/postcss": "^4.1.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "meshoptimizer": "^1.3.0",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
}
