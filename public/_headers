# Cloudflare static-asset headers (copied into ./out by the Next export; ignored by other hosts)
# Next's build output is content-hashed, so it never changes under the same name
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Android Trusted Web Activity domain verification (Digital Asset Links)
/.well-known/assetlinks.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# Security contact (RFC 9116), written at build time by src/app/.well-known/security.txt/route.ts
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
